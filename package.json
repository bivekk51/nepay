{
  "name": "nepay",
  "version": "0.1.0",
  "description": "Developer-first unified Nepal payments SDK (eSewa + Khalti)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "nepal",
    "payments",
    "esewa",
    "khalti",
    "epay",
    "epayment",
    "nepal-payments",
    "sdk",
    "typescript",
    "fintech"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bivekk51/nepay.git"
  },
  "homepage": "https://github.com/bivekk51/nepay#readme",
  "bugs": {
    "url": "https://github.com/bivekk51/nepay/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude '**/*live*'",
    "test:all": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:live": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/live.test.ts",
    "typecheck": "tsc --noEmit",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "docs:preview": "npm --prefix docs-site run preview"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
