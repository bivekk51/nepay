---
// Custom accessible lightweight dropdown theme selector for Starlight
---

<starlight-theme-select data-current-theme="auto">
  {/* Fallback hidden select for Starlight script / form compatibility */}
  <select class="sr-only" aria-hidden="true" tabindex="-1">
    <option value="dark">Dark</option>
    <option value="light">Light</option>
    <option value="auto" selected>Auto</option>
  </select>

  <div class="theme-dropdown-container">
    <button
      type="button"
      class="theme-toggle-btn"
      id="theme-toggle-btn"
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label="Select theme"
    >
      <span class="trigger-icon-wrap" aria-hidden="true">
        <svg class="trigger-theme-icon icon-light" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg class="trigger-theme-icon icon-dark" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
        <svg class="trigger-theme-icon icon-auto" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="12" x="3" y="4" rx="2"/>
          <path d="M2 20h20"/>
        </svg>
      </span>

      <span class="trigger-label">
        <span class="label-light">Light</span>
        <span class="label-dark">Dark</span>
        <span class="label-auto">System</span>
      </span>

      <svg class="caret-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 9 6 6 6-6"/>
      </svg>
    </button>

    <div
      class="theme-dropdown-menu"
      role="listbox"
      aria-labelledby="theme-toggle-btn"
      tabindex="-1"
    >
      <button
        type="button"
        role="option"
        class="theme-option"
        data-value="light"
        aria-selected="false"
      >
        <div class="option-left">
          <svg class="option-theme-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <span>Light</span>
        </div>
        <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </button>

      <button
        type="button"
        role="option"
        class="theme-option"
        data-value="dark"
        aria-selected="false"
      >
        <div class="option-left">
          <svg class="option-theme-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
          <span>Dark</span>
        </div>
        <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </button>

      <button
        type="button"
        role="option"
        class="theme-option"
        data-value="auto"
        aria-selected="false"
      >
        <div class="option-left">
          <svg class="option-theme-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="12" x="3" y="4" rx="2"/>
            <path d="M2 20h20"/>
          </svg>
          <span>System</span>
        </div>
        <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </button>
    </div>
  </div>
</starlight-theme-select>

{/* Inlined to avoid FOUC. Runs synchronously when parsed */}
<script is:inline>
  (() => {
    try {
      const stored = localStorage.getItem('starlight-theme');
      const theme = stored === 'light' || stored === 'dark' ? stored : 'auto';
      document.querySelectorAll('starlight-theme-select').forEach((el) => {
        el.setAttribute('data-current-theme', theme);
        const sel = el.querySelector('select');
        if (sel) sel.value = theme;
        const opt = el.querySelector(`[data-value="${theme}"]`);
        if (opt) opt.setAttribute('aria-selected', 'true');
      });
    } catch {}
  })();
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light';
  const storageKey = 'starlight-theme';

  const parseTheme = (theme: unknown): Theme =>
    theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

  function storeTheme(theme: Theme): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
    }
  }

  const getPreferredColorScheme = (): Theme =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  function onThemeChange(theme: Theme): void {
    const effectiveTheme = theme === 'auto' ? getPreferredColorScheme() : theme;
    document.documentElement.dataset.theme = effectiveTheme;
    storeTheme(theme);

    if (window.StarlightThemeProvider?.updatePickers) {
      window.StarlightThemeProvider.updatePickers(theme);
    }
    updateAllCustomPickers(theme);
  }

  function updateAllCustomPickers(theme: Theme): void {
    document.querySelectorAll<StarlightThemeSelect>('starlight-theme-select').forEach((picker) => {
      picker.setAttribute('data-current-theme', theme);
      picker.querySelectorAll<HTMLButtonElement>('.theme-option').forEach((opt) => {
        const isMatch = opt.dataset.value === theme;
        opt.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });
      const select = picker.querySelector('select');
      if (select) select.value = theme;
    });
  }

  // React to system color scheme change
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') {
      onThemeChange('auto');
    }
  });

  class StarlightThemeSelect extends HTMLElement {
    private btn: HTMLButtonElement | null = null;
    private menu: HTMLElement | null = null;
    private options: HTMLButtonElement[] = [];
    private isOpen = false;

    connectedCallback() {
      this.btn = this.querySelector('.theme-toggle-btn');
      this.menu = this.querySelector('.theme-dropdown-menu');
      this.options = Array.from(this.querySelectorAll('.theme-option'));

      const current = loadTheme();
      this.setAttribute('data-current-theme', current);
      this.updateSelectionState(current);

      this.btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        this.toggleMenu();
      });

      this.btn?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          this.openMenu();
          const selected = this.options.find((opt) => opt.getAttribute('aria-selected') === 'true') || this.options[0];
          selected?.focus();
        }
      });

      this.options.forEach((opt, idx) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const val = parseTheme(opt.dataset.value);
          onThemeChange(val);
          this.closeMenu();
          this.btn?.focus();
        });

        opt.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            const nextIdx = (idx + 1) % this.options.length;
            this.options[nextIdx].focus();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            const prevIdx = (idx - 1 + this.options.length) % this.options.length;
            this.options[prevIdx].focus();
          } else if (e.key === 'Escape') {
            e.preventDefault();
            this.closeMenu();
            this.btn?.focus();
          } else if (e.key === 'Tab') {
            this.closeMenu();
          }
        });
      });

      document.addEventListener('click', (e) => {
        if (this.isOpen && !this.contains(e.target as Node)) {
          this.closeMenu();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (this.isOpen && e.key === 'Escape') {
          this.closeMenu();
          this.btn?.focus();
        }
      });
    }

    private toggleMenu() {
      if (this.isOpen) {
        this.closeMenu();
      } else {
        this.openMenu();
      }
    }

    private openMenu() {
      document.querySelectorAll<StarlightThemeSelect>('starlight-theme-select').forEach((el) => {
        if (el !== this) el.closeMenu();
      });

      this.isOpen = true;
      this.menu?.classList.add('open');
      this.btn?.setAttribute('aria-expanded', 'true');
    }

    public closeMenu() {
      this.isOpen = false;
      this.menu?.classList.remove('open');
      this.btn?.setAttribute('aria-expanded', 'false');
    }

    private updateSelectionState(theme: Theme) {
      this.options.forEach((opt) => {
        opt.setAttribute('aria-selected', opt.dataset.value === theme ? 'true' : 'false');
      });
    }
  }

  if (!customElements.get('starlight-theme-select')) {
    customElements.define('starlight-theme-select', StarlightThemeSelect);
  }
</script>

<style>
  starlight-theme-select {
    display: inline-block;
    position: relative;
  }

  .theme-dropdown-container {
    position: relative;
    display: inline-block;
  }

  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding: 0 0.625rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    border-radius: 6px;
    border: 1px solid var(--sl-color-gray-5, rgba(255, 255, 255, 0.12));
    background-color: var(--sl-color-bg-nav, rgba(17, 18, 23, 0.6));
    color: var(--sl-color-gray-2, #a1a1aa);
    cursor: pointer;
    user-select: none;
    transition: all 0.15s ease;
  }

  .theme-toggle-btn:hover {
    color: var(--sl-color-white, #ffffff);
    border-color: var(--sl-color-gray-4, rgba(255, 255, 255, 0.22));
    background-color: var(--sl-color-gray-6, rgba(255, 255, 255, 0.06));
  }

  .theme-toggle-btn:focus-visible {
    outline: 2px solid var(--sl-color-accent, #6366f1);
    outline-offset: 2px;
  }

  .theme-toggle-btn[aria-expanded="true"] .caret-icon {
    transform: rotate(180deg);
  }

  .trigger-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .trigger-theme-icon {
    display: none;
  }

  .label-light,
  .label-dark,
  .label-auto {
    display: none;
  }

  starlight-theme-select[data-current-theme="light"] .icon-light {
    display: block;
  }
  starlight-theme-select[data-current-theme="light"] .label-light {
    display: inline;
  }

  starlight-theme-select[data-current-theme="dark"] .icon-dark {
    display: block;
  }
  starlight-theme-select[data-current-theme="dark"] .label-dark {
    display: inline;
  }

  starlight-theme-select[data-current-theme="auto"] .icon-auto {
    display: block;
  }
  starlight-theme-select[data-current-theme="auto"] .label-auto {
    display: inline;
  }

  .caret-icon {
    color: var(--sl-color-gray-3, #71717a);
    transition: transform 0.15s ease;
    margin-inline-start: 0.125rem;
  }

  .theme-dropdown-menu {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: 0;
    min-width: 8.5rem;
    padding: 0.25rem;
    border-radius: 8px;
    background-color: var(--sl-color-bg-nav, #14151b);
    border: 1px solid var(--sl-color-gray-5, rgba(255, 255, 255, 0.12));
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4), 0 4px 10px -2px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    z-index: 100;
    opacity: 0;
    transform: translateY(-4px) scale(0.97);
    pointer-events: none;
    transition: opacity 0.12s ease, transform 0.12s ease;
  }

  .theme-dropdown-menu.open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  :global(.mobile-preferences) .theme-dropdown-menu {
    top: auto;
    bottom: calc(100% + 0.375rem);
  }

  :global(.mobile-preferences) .theme-dropdown-menu:not(.open) {
    transform: translateY(4px) scale(0.97);
  }

  :global(.mobile-preferences) .theme-dropdown-menu.open {
    transform: translateY(0) scale(1);
  }

  .theme-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.375rem 0.5rem;
    border-radius: 5px;
    border: none;
    background: transparent;
    color: var(--sl-color-gray-2, #a1a1aa);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .option-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .option-theme-icon {
    color: var(--sl-color-gray-3, #71717a);
    transition: color 0.12s ease;
  }

  .theme-option:hover,
  .theme-option:focus-visible {
    background-color: var(--sl-color-gray-6, rgba(255, 255, 255, 0.06));
    color: var(--sl-color-white, #ffffff);
    outline: none;
  }

  .theme-option:hover .option-theme-icon,
  .theme-option:focus-visible .option-theme-icon {
    color: var(--sl-color-white, #ffffff);
  }

  .check-icon {
    opacity: 0;
    visibility: hidden;
    color: var(--sl-color-accent-high, #34d399);
    transition: opacity 0.12s ease;
  }

  starlight-theme-select[data-current-theme="light"] [data-value="light"] .check-icon,
  starlight-theme-select[data-current-theme="dark"] [data-value="dark"] .check-icon,
  starlight-theme-select[data-current-theme="auto"] [data-value="auto"] .check-icon {
    opacity: 1;
    visibility: visible;
  }

  starlight-theme-select[data-current-theme="light"] [data-value="light"],
  starlight-theme-select[data-current-theme="dark"] [data-value="dark"],
  starlight-theme-select[data-current-theme="auto"] [data-value="auto"] {
    color: var(--sl-color-white, #ffffff);
    font-weight: 600;
    background-color: var(--sl-color-gray-6, rgba(255, 255, 255, 0.04));
  }

  starlight-theme-select[data-current-theme="light"] [data-value="light"] .option-theme-icon,
  starlight-theme-select[data-current-theme="dark"] [data-value="dark"] .option-theme-icon,
  starlight-theme-select[data-current-theme="auto"] [data-value="auto"] .option-theme-icon {
    color: var(--sl-color-white, #ffffff);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
