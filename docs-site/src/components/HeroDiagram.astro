---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["hero-diagram-wrapper", className]} role="img" aria-label="Nepay payment gateway architecture and verification flow">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 380" width="100%" height="100%" fill="none" class="hero-svg">
    <defs>
      <radialGradient id="hero-glow" cx="50%" cy="30%" r="70%">
        <stop offset="0%" stop-color="#1a1b24" stop-opacity="0.8"/>
        <stop offset="100%" stop-color="#0a0a0c" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="card-border" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#2a2c36"/>
        <stop offset="50%" stop-color="#1c1d22"/>
        <stop offset="100%" stop-color="#121317"/>
      </linearGradient>
      <linearGradient id="stream-esewa" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#059669"/>
        <stop offset="100%" stop-color="#10B981"/>
      </linearGradient>
      <linearGradient id="stream-khalti" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#4F46E5"/>
        <stop offset="100%" stop-color="#8B5CF6"/>
      </linearGradient>
    </defs>

    <!-- Ambient Glow -->
    <rect width="540" height="380" rx="16" fill="url(#hero-glow)"/>

    <!-- Main Terminal Card -->
    <rect x="30" y="30" width="480" height="320" rx="12" fill="#0e0f14" stroke="url(#card-border)" stroke-width="1.2"/>
    
    <!-- Terminal Header -->
    <rect x="30" y="30" width="480" height="38" rx="12" fill="#14151b"/>
    <rect x="30" y="56" width="480" height="12" fill="#14151b"/>
    <line x1="30" y1="68" x2="510" y2="68" stroke="#1c1d22" stroke-width="1"/>
    
    <circle cx="50" cy="49" r="4.5" fill="#2a2b34"/>
    <circle cx="66" cy="49" r="4.5" fill="#2a2b34"/>
    <circle cx="82" cy="49" r="4.5" fill="#2a2b34"/>
    <text x="270" y="53" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="11" fill="#71717a">checkout.ts</text>

    <!-- Top Logo Accent inside Header -->
    <g transform="translate(470, 41)">
      <svg width="18" height="18" viewBox="0 0 64 64" fill="none">
        <path d="M 15 52 L 15 20 C 15 15.5 18 12 22.5 12 C 25.5 12 28.5 13.8 30.5 16.5 L 47 40"
              stroke="#FFFFFF" stroke-width="8" stroke-linecap="round"/>
        <path d="M 17 24 L 33.5 47.5 C 35.5 50.2 38.5 52 41.5 52 C 46 52 49 48.5 49 44 L 49 12"
              stroke="#71717a" stroke-width="8" stroke-linecap="round"/>
      </svg>
    </g>

    <!-- Code Preview Snippet -->
    <text x="54" y="102" font-family="'JetBrains Mono', monospace" font-size="12" fill="#818CF8">import</text>
    <text x="105" y="102" font-family="'JetBrains Mono', monospace" font-size="12" fill="#E4E4E7">{'{ initiatePayment }'}</text>
    <text x="250" y="102" font-family="'JetBrains Mono', monospace" font-size="12" fill="#818CF8">from</text>
    <text x="290" y="102" font-family="'JetBrains Mono', monospace" font-size="12" fill="#34D399">"@bivekkk/nepay"</text>
    <text x="410" y="102" font-family="'JetBrains Mono', monospace" font-size="12" fill="#71717A">;</text>

    <!-- Card Body Flow -->
    <rect x="54" y="125" width="432" height="195" rx="8" fill="#0a0a0c" stroke="#1c1d22" stroke-width="1"/>

    <!-- Left: eSewa Stream Node -->
    <g transform="translate(74, 150)">
      <rect width="105" height="60" rx="6" fill="#14151b" stroke="#22242b"/>
      <circle cx="20" cy="24" r="5" fill="#10B981"/>
      <text x="32" y="27" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="#E4E4E7">eSewa</text>
      <text x="20" y="47" font-family="'JetBrains Mono', monospace" font-size="10" fill="#71717A">ePay v2</text>
    </g>

    <!-- Right: Khalti Stream Node -->
    <g transform="translate(74, 230)">
      <rect width="105" height="60" rx="6" fill="#14151b" stroke="#22242b"/>
      <circle cx="20" cy="24" r="5" fill="#8B5CF6"/>
      <text x="32" y="27" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="#E4E4E7">Khalti</text>
      <text x="20" y="47" font-family="'JetBrains Mono', monospace" font-size="10" fill="#71717A">ePayment v2</text>
    </g>

    <!-- Center Connecting Bridge -->
    <path d="M 180 180 C 220 180, 220 220, 260 220" stroke="#10B981" stroke-width="2" stroke-dasharray="4 4"/>
    <path d="M 180 260 C 220 260, 220 220, 260 220" stroke="#8B5CF6" stroke-width="2" stroke-dasharray="4 4"/>

    <!-- Center Unified Nepay Core Node -->
    <g transform="translate(260, 180)">
      <rect width="205" height="80" rx="8" fill="#171822" stroke="#2f3140" stroke-width="1.2"/>
      
      <g transform="translate(16, 18)">
        <svg width="44" height="44" viewBox="0 0 64 64" fill="none">
          <path d="M 15 52 L 15 20 C 15 15.5 18 12 22.5 12 C 25.5 12 28.5 13.8 30.5 16.5 L 47 40"
                stroke="#FFFFFF" stroke-width="8" stroke-linecap="round"/>
          <path d="M 17 24 L 33.5 47.5 C 35.5 50.2 38.5 52 41.5 52 C 46 52 49 48.5 49 44 L 49 12"
                stroke="#0a0a0c" stroke-width="13" stroke-linecap="round"/>
          <path d="M 17 24 L 33.5 47.5 C 35.5 50.2 38.5 52 41.5 52 C 46 52 49 48.5 49 44 L 49 12"
                stroke="#A1A1AA" stroke-width="8" stroke-linecap="round"/>
        </svg>
      </g>

      <text x="70" y="38" font-family="Inter, sans-serif" font-size="15" font-weight="700" fill="#FFFFFF">nepay core</text>
      <text x="70" y="55" font-family="'JetBrains Mono', monospace" font-size="10.5" fill="#34D399">status: "completed"</text>
    </g>
  </svg>
</div>

<style>
  .hero-diagram-wrapper {
    margin: 1.5rem 0 2rem 0;
    width: 100%;
    max-width: 540px;
  }
  .hero-svg {
    width: 100%;
    height: auto;
    border-radius: 12px;
    display: block;
  }
</style>
